.vscode/
.idea/
*.swp
*.swo

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Environment files
*.env
.env.local
.env.*.local

# Local MCP server config (contains secrets, not shared with team)
.mcp.json
config.json
software-list
sentinelgo-test.exe
sentinelgo-auditlogs
.windsurf/
.kilo/
/release
coverage.html
