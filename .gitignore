# Local agent SQLite stores (created at runtime / by tests; never commit)
sentinelgo_*.db
sentinelgo_*.db-wal
sentinelgo_*.db-shm
tasks.sqlite
*.sqlite-wal
*.sqlite-shm

# Stray build/test outputs (e.g. `go build -o /dev/null` on Windows creates a
